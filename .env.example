# PayPal REST app credentials from https://developer.paypal.com/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional OpenAI-compatible Chat Completions API.
# If AI_API_KEY is empty, GuardCart uses its clearly labeled local demo recommender.
AI_API_KEY=
AI_MODEL=
AI_API_URL=https://api.openai.com/v1/chat/completions

PORT=3000
# Optional: set a persistent writable data directory when hosting the app.
DATA_DIR=
# By default, bind to localhost for a private local demo.
HOST=127.0.0.1
